# Copy to .env.local for local development. Never commit real values.

# Public site URL, used for auth email links, sitemaps and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). These two are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Older projects can use the legacy anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# SERVER ONLY. Never expose to the browser or prefix with NEXT_PUBLIC_.
# Used to sign photo URLs for visitors of published memories (after access
# checks) and to delete accounts. Legacy name SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=replace-me

# End-to-end tests against Supabase (optional). See README → Testing.
# E2E_SUPABASE=1

# Optional: WhatsApp enquiry button on published memories. International format,
# digits only (for example 919876543210). Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
